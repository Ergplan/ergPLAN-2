      "type": "object",
      "additionalProperties": false,
      "required": [
        "permitted",
        "eligibility",
        "sldc_clearance",
        "schedule",
        "notice",
        "contract_demand",
        "standby",
        "deviation_under",
        "deviation_over",
        "cross_subsidy_surcharge",
        "additional_surcharge",
        "banking",
        "lock_in"
      ],
      "properties": {
        "permitted": {
          "type": "object",
          "title": "May an open-access consumer buy on the power exchange",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "enum": [
                "stated",
                "not_stated"
              ],
              "description": "not_stated: no stored regulation states this (never a guess)"
            },
            "condition": {
              "type": "string",
              "maxLength": 600,
              "description": "The rule in plain words, as the client will read it"
            },
            "obtain": {
              "type": "string",
              "maxLength": 400,
              "description": "not_stated: the regulation or procedure that would have to be obtained"
            },
            "value": {
              "enum": [
                "yes",
                "no"
              ]
            }
          },
          "if": {
            "properties": {
              "status": {
                "const": "not_stated"
              }
            }
          },
          "then": {
            "required": [
              "obtain"
            ],
            "properties": {
              "value": false,
              "condition": false
            }
          },
          "else": {
            "required": [
              "value"
            ]
          }
        },
