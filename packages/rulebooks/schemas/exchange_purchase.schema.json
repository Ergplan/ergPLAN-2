              "type": "string",
              "pattern": "^\\d+(\\.\\d+)?$"
            },
            "min_voltage_kv": {
              "type": "string",
              "pattern": "^\\d+(\\.\\d+)?$"
            },
            "metering": {
              "type": "string",
              "maxLength": 300
            }
